def calculer_sha256(chemin):
try:
with open(chemin, "rb") as f:
return hashlib.sha256(f.read()).hexdigest()
except OSError:
return ""


def main():
log("=== NEXUS CERTIFICATE PRO GENERATOR v" + VERSION + " ===")
log("Auteur : " + AUTEUR + " (" + PSEUDO + ")")
log("Juridiction : " + JURIDICTION)
log("Dossier : " + PROJECT_DIR)
log("")

log("Ecriture des fichiers...")
ecrire(F_LICENSE_FR, LICENSE_FR)
ecrire(F_LICENSE_EN, LICENSE_EN)
ecrire(F_NOTICE, NOTICE_MD)
ecrire(F_PATENTS, PATENTS_MD)
ecrire(F_TRADEMARK, TRADEMARK_MD)
ecrire(F_CONTRIBUTORS, CONTRIBUTORS_MD)
ecrire(F_GOVERNANCE, GOVERNANCE_MD)
ecrire(F_SECURITY, SECURITY_MD)
ecrire(F_ETHICS, ETHICS_MD)
ecrire(F_COMPLIANCE, COMPLIANCE_MD)
ecrire(F_CHANGELOG, CHANGELOG_MD)
ecrire(F_README, README_MD)
ecrire(F_HEADER_PY, HEADER_PY)
ecrire(F_HEADER_JS, HEADER_JS)
ecrire(F_HEADER_GO, HEADER_GO)
ecrire(F_HEADER_RUST, HEADER_RUST)
ecrire(F_HEADER_C, HEADER_C)
ecrire(F_HEADER_YAML, HEADER_YAML)
ecrire(F_DOCKER, DOCKERFILE)

sha_licence = calculer_sha256(F_LICENSE_FR)
k8s_final = K8S_TEMPLATE.replace("__SHA__", sha_licence).replace("__SHA_SHORT__", sha_licence[:32])
ecrire(F_K8S, k8s_final)

log("")
log("Calcul des empreintes SHA-256...")

fichiers = [
F_LICENSE_FR, F_LICENSE_EN, F_NOTICE, F_PATENTS, F_TRADEMARK,
F_CONTRIBUTORS, F_GOVERNANCE, F_SECURITY, F_ETHICS, F_COMPLIANCE,
F_CHANGELOG, F_README, F_HEADER_PY, F_HEADER_JS, F_HEADER_GO,
F_HEADER_RUST, F_HEADER_C, F_HEADER_YAML, F_K8S, F_DOCKER,
]

empreintes = {}
total_octets = 0
for f in fichiers:
if os.path.isfile(f):
h = calculer_sha256(f)
t = os.path.getsize(f)
empreintes[os.path.basename(f)] = {"sha256": h, "taille": t}
total_octets += t

index = {
"version": VERSION,
"licence": LICENCE,
"auteur": AUTEUR,
"pseudo": PSEUDO,
"contact": CONTACT,
"juridiction": JURIDICTION,
"date": datetime.datetime.now(datetime.timezone.utc).isoformat(),
"dossier": PROJECT_DIR,
"articles": 30,
"annexes": 4,
"langues": ["fr", "en"],
"empreintes": empreintes,
"sha256_licence_fr": calculer_sha256(F_LICENSE_FR),
"sha256_licence_en": calculer_sha256(F_LICENSE_EN),
"total_octets": total_octets,
"total_fichiers": len(empreintes),
}
index["empreinte_globale"] = hashlib.sha256(
json.dumps(index, sort_keys=True, default=str).encode()
).hexdigest()

with open(F_INDEX, "w", encoding="utf-8") as f:
json.dump(index, f, indent=2, ensure_ascii=False)

log("")
log("=== CERTIFICAT NEXUS-OPEN-2.0 ===")
log("Licence : " + LICENCE)
log("Auteur : " + AUTEUR + " (" + PSEUDO + ")")
log("Contact : " + CONTACT)
log("Juridiction : " + JURIDICTION)
log("Articles : 30")
log("Annexes : 4")
log("Langues : FR + EN")
log("SHA-256 licence : " + index["sha256_licence_fr"])
log("SHA-256 global : " + index["empreinte_globale"])
log("Total fichiers : " + str(len(empreintes)))
log("Total octets : " + str(total_octets))
log("")
log("Fichiers generes :")
for f in fichiers + [F_INDEX]:
if os.path.isfile(f):
t = os.path.getsize(f)
log(" " + os.path.basename(f) + " (" + str(t) + " octets)")
log("")
log("Pour publier :")
log(" cd " + PROJECT_DIR)
log(" git init")
log(" git add .")
log(" git commit -m 'NEXUS-OPEN-2.0'")
log(" git remote add origin https://github.com/TON_PSEUDO/nexus-open-license.git")
log(" git push -u origin main")
log("")


if __name__ == "__main__":
main()
