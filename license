def log(msg):
print("[NEXUS-PRO] " + msg)


def ecrire(chemin, contenu):
with open(chemin, "w", encoding="utf-8") as f:
f.write(contenu)
try:
taille = os.path.getsize(chemin)
except OSError:
taille = 0
log("Ecrit : " + os.path.basename(chemin) + " (" + str(taille) + " octets)")


