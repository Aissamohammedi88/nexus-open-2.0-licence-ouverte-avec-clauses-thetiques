def verifier_depot(entite, url):
"""Verifie si un depot contient des references a NEXUS sans mention licence."""
r = http_get(url)
if not r.get("ok"):
return {
"entite": entite,
"url": url,
"ok": False,
"erreur": r.get("erreur", ""),
"nexus_detecte": False,
"licence_nexus": False,
"violation": False,
}

body = r["body"].lower()
nexus = "nexus" in body
licence = "nexus-open" in body or "aissa mohammedi" in body or "dgk" in body

return {
"entite": entite,
"url": url,
"ok": True,
"status": r.get("status", 200),
"taille": r["taille"],
"sha256": r["sha256"],
"nexus_detecte": nexus,
"licence_nexus": licence,
"violation": nexus and not licence,
}


def analyser_texte(texte, contexte=""):
"""Cherche des motifs de violation dans un texte."""
violations = []
if not texte:
return violations

low = texte.lower()
for nom, patterns in MOTS_VIOLATION.items():
for pat in patterns:
try:
for m in re.finditer(pat, low, re.IGNORECASE):
debut = max(0, m.start() - 80)
fin = min(len(texte), m.end() + 80)
extrait = texte[debut:fin].replace("\n", " ").strip()
violations.append({
"type": nom,
"contexte": contexte,
"extrait": extrait[:250],
})
break
except Exception:
pass
return violations


def scanner_entites():
