for url in info["urls_a_surveiller"]:
log(" " + url)
r = verifier_depot(entite, url)
r["clause"] = info["clause"]
r["obligation"] = info["obligation"]
if r.get("ok"):
log(" OK nexus=" + str(r["nexus_detecte"]) +
" licence=" + str(r["licence_nexus"]) +
" violation=" + str(r["violation"]))
else:
log(" KO " + str(r.get("erreur", ""))[:80])
resultats.append(r)
time.sleep(0.4)
return resultats


def scanner_texte_local(chemin):
"""Cherche des violations dans un fichier local."""
try:
with open(chemin, "r", encoding="utf-8", errors="ignore") as f:
contenu = f.read()
except OSError:
return []

violations = analyser_texte(contenu, contexte=chemin)
if violations:
log("[LOCAL] " + chemin + " : " + str(len(violations)) + " violations")
return violations


def scanner_dossier_local(dossier):
"""Cherche dans tous les fichiers d'un dossier."""
violations = []
for root, dirs, files in os.walk(dossier):
if ".git" in root:
continue
for fn in files:
if fn.endswith((".py", ".md", ".txt", ".json", ".js", ".html")):
chemin = os.path.join(root, fn)
violations.extend(scanner_texte_local(chemin))
return violations


