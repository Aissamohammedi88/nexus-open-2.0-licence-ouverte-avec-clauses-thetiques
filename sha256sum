```javascript
const sceau = await crypto.subtle.digest('SHA-256',
new TextEncoder().encode(JSON.stringify(genome)));
console.log(Array.from(new Uint8Array(sceau))
.map(b => b.toString(16).padStart(2, '0')).join(''));
